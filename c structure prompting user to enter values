//c structures  
 
  #include <stdio.h>
#include <string.h>

struct book {
  char title[30];                                                     char author[30];
        int publication_year;
         char ISBN[13];
         float price;
};
int main() {
    struct book book1;

    printf("\nEnter the book details:\n");
    printf("Title: ");
    fgets(book1.title, 30, stdin);
    printf("Author: ");
    fgets(book1.author, 30, stdin);
    printf("Publication Year: ");
    scanf("%d", &book1.publication_year);
    printf("ISBN: ");
    scanf("%s", book1.ISBN);
    printf("Price: ");
    scanf("%f", &book1.price);

    printf("\nBook Details:\n");
    printf("Title: %s", book1.title);
    printf("Author: %s", book1.author);
    printf("Publication Year: %d\n", book1.publication_year);
    printf("ISBN: %s\n", book1.ISBN);
    printf("Price: %.2f\n", book1.price);
    return 0;
}
